local ConfigLoaded = false

local function SaveUIConfig()
    pcall(function()
        if writefile then
            if isfolder and not isfolder(ConfigFolder) then
                if makefolder then makefolder(ConfigFolder) end
            end
            local data = {
                Theme = CurrentTheme,
                ToggleKey = tostring(ToggleKey.Name)
            }
            writefile(ConfigFolder .. "/" .. ConfigFile, HttpService:JSONEncode(data))
        end
    end)
end

local function LoadUIConfig()
    pcall(function()
        if not readfile then return end
        local path = ConfigFolder .. "/" .. ConfigFile
        local exists = false
        if isfile then
            exists = isfile(path)
        else
            local ok, _ = pcall(function() readfile(path) end)
            exists = ok
        end
        if exists then
            local raw = readfile(path)
            local data = HttpService:JSONDecode(raw)
            if data.Theme and Themes[data.Theme] then
                CurrentTheme = data.Theme
                Theme = Themes[CurrentTheme]
            end
            if data.ToggleKey then
                local key = Enum.KeyCode[data.ToggleKey]
                if key then
                    ToggleKey = key
                    ConfigLoaded = true
                end
            end
        end
    end)
end

LoadUIConfig()

local function Create(class, props)
    local obj = Instance.new(class)
    for i, v in pairs(props or {}) do
        obj[i] = v
    end
    return obj
end

local function Tween(obj, props, time, style, direction)
    local tw = TweenService:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

