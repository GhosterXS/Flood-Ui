--[[
    Simple UI Library - Estilo Rayfield
    Criado para ser leve e fácil de usar
]]

local Library = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local function Create(class, props)
    local obj = Instance.new(class)
    for i, v in pairs(props or {}) do
        obj[i] = v
    end
    return obj
end

local function Tween(obj, props, time)
    TweenService:Create(obj, TweenInfo.new(time or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

function Library:CreateWindow(config)
    config = config or {}
    local Name = config.Name or "UI Library"
    local Theme = config.Theme or Color3.fromRGB(100, 100, 255)

    -- Remove UI antiga se existir
    if CoreGui:FindFirstChild("CustomUI") then
        CoreGui.CustomUI:Destroy()
    end

    local ScreenGui = Create("ScreenGui", {
        Name = "CustomUI",
        Parent = CoreGui,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false
    })

    local Main = Create("Frame", {
        Name = "Main",
        Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(20, 20, 25),
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, -250, 0.5, -175),
        Size = UDim2.new(0, 500, 0, 350),
        ClipsDescendants = true
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Main})

    -- Sombra
    local Shadow = Create("ImageLabel", {
        Name = "Shadow",
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, -15, 0, -15),
        Size = UDim2.new(1, 30, 1, 30),
        ZIndex = 0,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.5,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450)
    })

    -- Topbar
    local Topbar = Create("Frame", {
        Name = "Topbar",
        Parent = Main,
        BackgroundColor3 = Color3.fromRGB(25, 25, 30),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40)
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Topbar})

    -- Corrige o canto inferior do topbar
    Create("Frame", {
        Parent = Topbar,
        BackgroundColor3 = Color3.fromRGB(25, 25, 30),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -10),
        Size = UDim2.new(1, 0, 0, 10)
    })

    local Title = Create("TextLabel", {
        Parent = Topbar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 15, 0, 0),
        Size = UDim2.new(1, -50, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = Name,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    -- Botão fechar
    local CloseBtn = Create("TextButton", {
        Parent = Topbar,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -35, 0.5, -10),
        Size = UDim2.new(0, 20, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = "×",
        TextColor3 = Color3.fromRGB(200, 200, 200),
        TextSize = 22
    })
    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    -- Arrastar a janela
    local Dragging, DragStart, StartPos
    Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            DragStart = input.Position
            StartPos = Main.Position
        end
    end)
    Topbar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - DragStart
            Main.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)

    -- Container das Tabs
    local TabContainer = Create("Frame", {
        Parent = Main,
        BackgroundColor3 = Color3.fromRGB(22, 22, 27),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 40),
        Size = UDim2.new(0, 130, 1, -40)
    })

    local TabList = Create("ScrollingFrame", {
        Parent = TabContainer,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme
    })
    Create("UIListLayout", {
        Parent = TabList,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5)
    })
    Create("UIPadding", {
        Parent = TabList,
        PaddingTop = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8)
    })

    -- Container dos Elementos
    local Content = Create("Frame", {
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 130, 0, 40),
        Size = UDim2.new(1, -130, 1, -40)
    })

    local Tabs = {}
    local SelectedTab = nil

    local Window = {}

    function Window:CreateTab(TabName)
        local TabButton = Create("TextButton", {
            Parent = TabList,
            BackgroundColor3 = Color3.fromRGB(30, 30, 35),
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 32),
            Font = Enum.Font.Gotham,
            Text = TabName,
            TextColor3 = Color3.fromRGB(180, 180, 180),
            TextSize = 13,
            AutoButtonColor = false
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = TabButton})

        local Elements = Create("ScrollingFrame", {
            Parent = Content,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme,
            Visible = false
        })
        Create("UIListLayout", {
            Parent = Elements,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8)
        })
        Create("UIPadding", {
            Parent = Elements,
            PaddingTop = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 10)
        })

        -- Atualiza o tamanho do canvas
        Elements.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Elements.CanvasSize = UDim2.new(0, 0, 0, Elements.UIListLayout.AbsoluteContentSize.Y + 20)
        end)

        TabList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabList.CanvasSize = UDim2.new(0, 0, 0, TabList.UIListLayout.AbsoluteContentSize.Y + 16)
        end)

        local function Select()
            if SelectedTab then
                SelectedTab.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                SelectedTab.Button.TextColor3 = Color3.fromRGB(180, 180, 180)
                SelectedTab.Elements.Visible = false
            end
            SelectedTab = {Button = TabButton, Elements = Elements}
            TabButton.BackgroundColor3 = Theme
            TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            Elements.Visible = true
        end

        TabButton.MouseButton1Click:Connect(Select)

        -- Seleciona a primeira tab automaticamente
        if not SelectedTab then
            Select()
        end

        local Tab = {}

        -- ========== BUTTON ==========
        function Tab:CreateButton(opts)
            opts = opts or {}
            local Btn = Create("TextButton", {
                Parent = Elements,
                BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 36),
                Font = Enum.Font.Gotham,
                Text = opts.Name or "Button",
                TextColor3 = Color3.fromRGB(230, 230, 230),
                TextSize = 13,
                AutoButtonColor = false
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Btn})

            Btn.MouseEnter:Connect(function()
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(40, 40, 50)})
            end)
            Btn.MouseLeave:Connect(function()
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(30, 30, 38)})
            end)
            Btn.MouseButton1Click:Connect(function()
                if opts.Callback then
                    opts.Callback()
                end
            end)
        end

        -- ========== TOGGLE ==========
        function Tab:CreateToggle(opts)
            opts = opts or {}
            local Value = opts.Default or false

            local Frame = Create("Frame", {
                Parent = Elements,
                BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 40)
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Frame})

            local Label = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -60, 1, 0),
                Font = Enum.Font.Gotham,
                Text = opts.Name or "Toggle",
                TextColor3 = Color3.fromRGB(230, 230, 230),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ToggleBg = Create("Frame", {
                Parent = Frame,
                BackgroundColor3 = Value and Theme or Color3.fromRGB(50, 50, 60),
                Position = UDim2.new(1, -48, 0.5, -10),
                Size = UDim2.new(0, 36, 0, 20)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ToggleBg})

            local Circle = Create("Frame", {
                Parent = ToggleBg,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Position = Value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                Size = UDim2.new(0, 16, 0, 16)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Circle})

            local function Set(val)
                Value = val
                Tween(ToggleBg, {BackgroundColor3 = Value and Theme or Color3.fromRGB(50, 50, 60)})
                Tween(Circle, {Position = Value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
                if opts.Callback then
                    opts.Callback(Value)
                end
            end

            Frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Set(not Value)
                end
            end)
        end

        -- ========== SLIDER ==========
        function Tab:CreateSlider(opts)
            opts = opts or {}
            local Min = opts.Min or 0
            local Max = opts.Max or 100
            local Value = opts.Default or Min

            local Frame = Create("Frame", {
                Parent = Elements,
                BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 50)
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Frame})

            local Label = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 4),
                Size = UDim2.new(0.7, 0, 0, 20),
                Font = Enum.Font.Gotham,
                Text = opts.Name or "Slider",
                TextColor3 = Color3.fromRGB(230, 230, 230),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ValueLabel = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0.7, 0, 0, 4),
                Size = UDim2.new(0.3, -12, 0, 20),
                Font = Enum.Font.Gotham,
                Text = tostring(Value),
                TextColor3 = Theme,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right
            })

            local SliderBg = Create("Frame", {
                Parent = Frame,
                BackgroundColor3 = Color3.fromRGB(45, 45, 55),
                Position = UDim2.new(0, 12, 0, 30),
                Size = UDim2.new(1, -24, 0, 6)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SliderBg})

            local Fill = Create("Frame", {
                Parent = SliderBg,
                BackgroundColor3 = Theme,
                Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

            local Sliding = false
            local function Update(input)
                local pos = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                Value = math.floor(Min + (Max - Min) * pos)
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                ValueLabel.Text = tostring(Value)
                if opts.Callback then
                    opts.Callback(Value)
                end
            end

            SliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Sliding = true
                    Update(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if Sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    Update(input)
                end
            end)
        end

        -- ========== DROPDOWN ==========
        function Tab:CreateDropdown(opts)
            opts = opts or {}
            local Options = opts.Options or {"Option 1"}
            local Selected = opts.Default or Options[1]
            local Open = false

            local Frame = Create("Frame", {
                Parent = Elements,
                BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 40),
                ClipsDescendants = true
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Frame})

            local Label = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -40, 0, 40),
                Font = Enum.Font.Gotham,
                Text = (opts.Name or "Dropdown") .. ": " .. Selected,
                TextColor3 = Color3.fromRGB(230, 230, 230),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local Arrow = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -30, 0, 0),
                Size = UDim2.new(0, 20, 0, 40),
                Font = Enum.Font.Gotham,
                Text = "▼",
                TextColor3 = Color3.fromRGB(180, 180, 180),
                TextSize = 12
            })

            local OptionsFrame = Create("Frame", {
                Parent = Frame,
                BackgroundColor3 = Color3.fromRGB(25, 25, 32),
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0, 40),
                Size = UDim2.new(1, 0, 0, #Options * 30)
            })

            for i, opt in ipairs(Options) do
                local OptBtn = Create("TextButton", {
                    Parent = OptionsFrame,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, (i-1)*30),
                    Size = UDim2.new(1, 0, 0, 30),
                    Font = Enum.Font.Gotham,
                    Text = opt,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 12,
                    AutoButtonColor = false
                })
                OptBtn.MouseEnter:Connect(function()
                    OptBtn.TextColor3 = Theme
                end)
                OptBtn.MouseLeave:Connect(function()
                    OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                end)
                OptBtn.MouseButton1Click:Connect(function()
                    Selected = opt
                    Label.Text = (opts.Name or "Dropdown") .. ": " .. Selected
                    Open = false
                    Tween(Frame, {Size = UDim2.new(1, 0, 0, 40)})
                    Arrow.Text = "▼"
                    if opts.Callback then
                        opts.Callback(Selected)
                    end
                end)
            end

            Frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Open = not Open
                    if Open then
                        Tween(Frame, {Size = UDim2.new(1, 0, 0, 40 + #Options * 30)})
                        Arrow.Text = "▲"
                    else
                        Tween(Frame, {Size = UDim2.new(1, 0, 0, 40)})
                        Arrow.Text = "▼"
                    end
                end
            end)
        end

        -- ========== LABEL ==========
        function Tab:CreateLabel(text)
            local Label = Create("TextLabel", {
                Parent = Elements,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 25),
                Font = Enum.Font.Gotham,
                Text = text or "Label",
                TextColor3 = Color3.fromRGB(160, 160, 160),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })
        end

        -- ========== SECTION ==========
        function Tab:CreateSection(text)
            local Section = Create("TextLabel", {
                Parent = Elements,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 28),
                Font = Enum.Font.GothamBold,
                Text = text or "Section",
                TextColor3 = Theme,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left
            })
        end

        return Tab
    end

    return Window
end

return Library
